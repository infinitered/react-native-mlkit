{
  "compilerOptions": {
    // Metro resolves imports like a bundler; Node16 rejects ESM-only type packages (e.g. reanimated 4.7)
    "module": "preserve",
    "moduleResolution": "bundler",
    // TS 6 no longer auto-includes every @types package; test/ uses Node APIs
    "types": ["jest", "node"],
    "paths": {
      "app/*": [
        "./app/*"
      ],
      "~/*": [
        "./app/*"
      ],
      "images/*": [
        "./assets/images/*"
      ],
      "assets/*": [
        "./assets/*"
      ]
    }
  },
  "extends": "@infinitered/tsconfig/expo-app-no-strict",
  "ts-node": {
    "compilerOptions": {
      // compilerOptions specified here will override those declared above,
      // but *only* in ts-node.  Useful if you want ts-node and tsc to use
      // different options with a single tsconfig.json.
//      "module": "commonjs"
    }
  },
  "include": ["index.js", "App.tsx", "app", "types", "plugins", "app.config.ts"],
  "exclude": ["node_modules", "test/**/*"]
}
