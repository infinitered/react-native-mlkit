{
  "compilerOptions": {
    // SDK 56's base tsconfig switched to the automatic JSX runtime ("react-jsx"),
    // which flags this app's classic-style `import React` statements as unused.
    // Metro/Babel still use the automatic runtime at build time; this only pins
    // tsc's type-checking to the classic runtime to match the existing source.
    "jsx": "react-native",
    "baseUrl": ".",
    "paths": {
      "app/*": [
        "./app/*"
      ],
      "~/*": [
        "./app/*"
      ],
      "images/*": [
        "./assets/images/*"
      ],
      "assets/*": [
        "./assets/*"
      ]
    }
  },
  "extends": "@infinitered/tsconfig/expo-app-no-strict",
  "ts-node": {
    "compilerOptions": {
      // compilerOptions specified here will override those declared above,
      // but *only* in ts-node.  Useful if you want ts-node and tsc to use
      // different options with a single tsconfig.json.
//      "module": "commonjs"
    }
  },
  "include": ["index.js", "App.tsx", "app", "types", "plugins", "app.config.ts"],
  "exclude": ["node_modules", "test/**/*"]
}
